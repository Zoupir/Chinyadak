# Application
NODE_ENV=production
PORT=3000
APP_URL=https://example.com

# MySQL (DirectAdmin database credentials)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chinpart
DB_USER=chinpart_user
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=10

# Authentication
# Generate a long random value (at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=chinpart_session

# First production administrator.
# Used only when the administrators table is empty.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_BOOTSTRAP_NAME=مدیر سیستم

# AI advisor (optional)
GEMINI_API_KEY=

# Reverse proxy / DirectAdmin
TRUST_PROXY=1

# Payments
# Store prices are in Toman; Iranian bank gateways receive Rial.
PAYMENT_RESERVATION_MINUTES=30

# Saman Electronic Payment (SEP)
SEP_TERMINAL_ID=
SEP_TOKEN_URL=https://sep.shaparak.ir/onlinepg/onlinepg
SEP_PAYMENT_URL=https://sep.shaparak.ir/OnlinePG/SendToken
SEP_VERIFY_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/VerifyTransaction
SEP_REVERSE_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/ReverseTransaction

# Behpardakht Mellat
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_WSDL_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw?wsdl
MELLAT_PAYMENT_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat

# Secure application storage
# Use a different random secret from JWT_SECRET, at least 32 characters.
APP_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET

# Media uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
# Rich audio/video is streamed to disk; this is a size limit, not a RAM buffer.
MAX_RICH_MEDIA_MB=96
# Sensitive inquiry attachments live outside the public /uploads tree.
PRIVATE_UPLOAD_DIR=private-uploads
