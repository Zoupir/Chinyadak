# Application
NODE_ENV=production
PORT=3000
APP_URL=https://example.com

# MySQL (DirectAdmin database credentials)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chinpart
DB_USER=chinpart_user
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=10

# Authentication
# Generate a long random value (at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=chinpart_session

# First production administrator.
# Used only when the administrators table is empty.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_BOOTSTRAP_NAME=مدیر سیستم

# AI advisor (optional)
GEMINI_API_KEY=

# Reverse proxy / DirectAdmin
TRUST_PROXY=1
