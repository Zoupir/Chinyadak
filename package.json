{
  "name": "chinpart",
  "private": true,
  "version": "30.1.18",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=server.js --packages=external",
    "start": "NODE_ENV=production node server.js",
    "db:init": "tsx scripts/init-db.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "db:seed-demo": "tsx scripts/seed-demo-data.ts",
    "payments:release-expired": "tsx scripts/release-expired-reservations.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "seo:worker": "tsx scripts/seo-worker.ts",
    "seo:audit": "tsx -e \"import('./src/server/seo/platform.ts').then(async m=>{await m.runFullSeoAudit();process.exit(0)})\"",
    "seo:graph": "tsx -e \"import('./src/server/seo/platform.ts').then(async m=>{await m.rebuildSeoKnowledgeGraph();process.exit(0)})\"",
    "db:seed-real-defaults": "tsx scripts/seed-real-defaults.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.0",
    "express-rate-limit": "^8.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "soap": "^1.6.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0"
  }
}
