    "db:seed": "tsx scripts/seed-catalog.ts",
    "payments:release-expired": "tsx scripts/release-expired-reservations.ts",
    "test:smoke": "tsx scripts/smoke-test.ts && tsx scripts/smoke-v3082.ts && tsx scripts/smoke-v3090.ts && tsx scripts/smoke-v3091.ts && tsx scripts/smoke-v3092.ts && tsx scripts/smoke-v30100.ts && tsx scripts/smoke-v30101.ts && tsx scripts/smoke-v30102.ts && tsx scripts/smoke-v30103.ts && tsx scripts/smoke-v30104.ts && tsx scripts/smoke-v30105.ts && tsx scripts/smoke-v30106.ts && tsx scripts/smoke-v30107.ts",
