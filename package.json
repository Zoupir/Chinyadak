    "build": "npm run prepare:source && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node server.js",
    "db:init": "tsx scripts/init-db.ts && tsx scripts/migrate-v3060-part-brands.ts && tsx scripts/migrate-private-part-request-files.ts && tsx scripts/reconcile-v30102-data.ts",
