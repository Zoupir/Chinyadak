    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "seo:worker": "tsx -e \"import('./src/server/seo/platform.ts').then(async m=>{await m.runFullSeoAudit();process.exit(0)})\"",
    "seo:graph": "tsx -e \"import('./src/server/seo/platform.ts').then(async m=>{await m.rebuildSeoKnowledgeGraph();process.exit(0)})\"",
